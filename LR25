#include <iostream>
using namespace std;

class Tree {
public:
    virtual void draw() {
        cout << "Base tree drawing\n";
    }
    virtual ~Tree() {}
};

class Tree1 : public Tree {
public:
    void draw() override {
        cout << "Drawing 1:\n";
        cout << " /\\\n";
        cout << "//\\\\\n";
    }
};

class Tree2 : public Tree {
public:
    void draw() override {
        cout << "Drawing 2:\n";
        cout << " /\\\n";
        cout << "/**\\\n";
    }
};

class Tree3 : public Tree {
public:
    void draw() override {
        cout << "Drawing 3:\n";
        cout << " /\\\n";
        cout << "/++\\\n";
    }
};

int main() {
    Tree* forest[3];

    Tree1 t1;
    Tree2 t2;
    Tree3 t3;

    forest[0] = &t1;
    forest[1] = &t2;
    forest[2] = &t3;

    for (int i = 0; i < 3; i++) {
        forest[i]->draw();
    }

    return 0;
}
